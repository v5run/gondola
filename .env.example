# Copy to .env and fill in what you have. Everything is optional: with nothing set, Gondola runs offline
# (texts/emails -> out/outbox.jsonl, app pauses -> out/actions_log.jsonl, wording from templates).
# Demo safety boundary: app notifications and merchant writes remain disabled even with credentials.
# See docs/development/SECURITY_AUDIT.md before enabling any real integrations.

# Twilio SMS (paid account; a Canadian number texting the team's Canadian phones needs no 10DLC registration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
ALERT_SMS_TO=+1XXXXXXXXXX,+1XXXXXXXXXX

# SendGrid email (authenticate a sending domain first)
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=gondola@yourdomain.com
ALERT_EMAIL_TO=you@example.com

# LLM wording and the ADK Ask agent (paid tier; pin a current model)
GOOGLE_API_KEY=
GONDOLA_MODEL=gemini-flash-latest
# or Anthropic for wording only
ANTHROPIC_API_KEY=
GONDOLA_ANTHROPIC_MODEL=claude-sonnet-5-5

# Square sandbox (Developer Dashboard > Sandbox > access token + location id)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox

# DoorDash Marketplace (needs partner access; test store from the Developer Portal)
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_STORE_ID=

# Optional
CHROME_PATH=
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Agent mode: run the Google ADK agent graph (Close Coordinator + Ask) for wording and explanations.
# Needs GOOGLE_API_KEY (or Vertex settings). Numbers always come from the deterministic pipeline.
# Leave empty for the offline pipeline + templates.
GONDOLA_AGENTS=
